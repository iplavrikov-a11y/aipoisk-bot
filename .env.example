# Runtime
AIPOISK_PUBLIC_BASE_URL=https://aipoisk.lexelence.ru
AIPOISK_DATABASE_URL=sqlite:///../data/aipoisk.db
AIPOISK_STORAGE_DIR=../storage
AIPOISK_ADMIN_USERNAME=admin
AIPOISK_ADMIN_PASSWORD=change-this-password
AIPOISK_ADMIN_SESSION_HOURS=24
AIPOISK_ADMIN_TOKEN=change-me

# Telegram
AIPOISK_BOT_TOKEN=

# Optional: seed first admin client by Telegram ID
AIPOISK_OWNER_TELEGRAM_ID=

# Optional defaults for the first settings row.
# Verified local EmailAgent-compatible provider base URLs on this VPS:
# - OpenAI-compatible CLIProxyAPI: http://127.0.0.1:8317/v1
# - Gemini proxy: http://202.71.13.57/gemini/v1
AIPOISK_DEFAULT_CUSTOM_AI_PROVIDERS_JSON=[]
AIPOISK_DEFAULT_SAVED_MODELS_JSON=[]
AIPOISK_DEFAULT_AI_FUNCTION_MODELS_JSON={}
AIPOISK_DEFAULT_PRIMARY_PROVIDER=
AIPOISK_DEFAULT_PRIMARY_MODEL=
AIPOISK_DEFAULT_LIGHT_PROVIDER=
AIPOISK_DEFAULT_LIGHT_MODEL=
AIPOISK_DEFAULT_SUPPLIER_SEARCH_ADAPTER_BASE_URL=
AIPOISK_DEFAULT_SUPPLIER_SEARCH_ADAPTER_API_KEY=
AIPOISK_DEFAULT_SUPPLIER_SEARCH_ADAPTER_MODEL=
AIPOISK_DEFAULT_SUPPLIER_SEARCH_PROVIDER_ORDER=yandex,google,tavily,ddgs
AIPOISK_DEFAULT_YANDEX_SEARCH_FOLDER_ID=
AIPOISK_DEFAULT_YANDEX_SEARCH_API_KEY=
AIPOISK_DEFAULT_GOOGLE_SEARCH_API_KEY=
AIPOISK_DEFAULT_GOOGLE_SEARCH_CSE_ID=
AIPOISK_SEARCH_QUERY_LIMIT=18
AIPOISK_DEFAULT_DOCUMENT_SETTINGS_JSON={"ocr_enabled":true,"pdf_ocr_pages":3,"archive_max_files":80,"archive_max_mb":250,"archive_depth":2}

# Tenderplan integration. Keep the token server-side only.
AIPOISK_TENDERPLAN_API_TOKEN=
AIPOISK_TENDERPLAN_BASE_URL=https://tenderplan.ru
AIPOISK_TENDER_SOURCE_SERVICE_URL=http://127.0.0.1:8096
AIPOISK_TENDER_SOURCE_SERVICE_TIMEOUT_SECONDS=60
AIPOISK_TENDERPLAN_DOWNLOAD_PROXY_URL=socks5://127.0.0.1:1080
AIPOISK_TENDERPLAN_DOWNLOAD_RETRIES=2
AIPOISK_TENDERPLAN_MAX_DOCUMENTS=60
AIPOISK_TENDERPLAN_MAX_DOCUMENT_MB=80
