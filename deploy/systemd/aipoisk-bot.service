[Unit]
Description=TenderLex Telegram Bot
After=network.target aipoisk-api.service
Wants=network-online.target
PartOf=aipoisk-api.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/root/projects/tenderlex/backend
Environment=PYTHONPATH=/root/projects/tenderlex/backend
Environment=OMP_THREAD_LIMIT=1
Environment=SUPPLIER_MINPROM_REGISTRY_CACHE_DIR=/root/projects/tenderlex/data/minprom_registry
EnvironmentFile=/root/projects/tenderlex/.env
ExecStart=/root/projects/tenderlex/backend/.venv/bin/python -m app.bot
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aipoisk-bot
MemoryHigh=512M
MemoryMax=768M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
