[Unit]
Description=AI Poisk Backend (FastAPI)
After=network.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/root/projects/aipoisk-bot/backend
Environment=PYTHONPATH=/root/projects/aipoisk-bot/backend
Environment=OMP_THREAD_LIMIT=1
EnvironmentFile=/root/projects/aipoisk-bot/.env
ExecStart=/root/projects/aipoisk-bot/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8088 --no-access-log
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aipoisk-api
MemoryHigh=1024M
MemoryMax=1536M
CPUQuota=150%

[Install]
WantedBy=multi-user.target
