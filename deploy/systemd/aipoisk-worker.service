[Unit]
Description=TenderLex Durable Job Worker
After=network.target aipoisk-api.service
Wants=network-online.target
PartOf=aipoisk-api.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/root/projects/aipoisk-bot/backend
Environment=PYTHONPATH=/root/projects/aipoisk-bot/backend
Environment=OMP_THREAD_LIMIT=1
EnvironmentFile=/root/projects/aipoisk-bot/.env
ExecStart=/root/projects/aipoisk-bot/backend/.venv/bin/python -m app.worker
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aipoisk-worker
MemoryHigh=1024M
MemoryMax=1536M
CPUQuota=150%

[Install]
WantedBy=multi-user.target
