[Unit]
Description=TenderLex Backend (FastAPI)
After=network.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/root/projects/tenderlex/backend
Environment=PYTHONPATH=/root/projects/tenderlex/backend
Environment=OMP_THREAD_LIMIT=1
Environment=SUPPLIER_MINPROM_REGISTRY_CACHE_DIR=/root/projects/tenderlex/data/minprom_registry
EnvironmentFile=/root/projects/tenderlex/.env
ExecStart=/root/projects/tenderlex/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8088 --no-access-log --limit-max-requests 10000 --limit-max-requests-jitter 1000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tenderlex-api
MemoryHigh=1024M
MemoryMax=1536M
CPUQuota=150%

[Install]
WantedBy=multi-user.target
